{
    "name": "xbox-theme",
    "displayName": "Xbox Theme",
    "description": "Visual Studio Code color themes inspired by every Xbox console generation (Original, 360, ONE, Series X) plus High Contrast Dark & Light editions.",
    "version": "0.8.2",
    "icon": "images/xbox-logo.png",
    "publisher": "hector-jimenez",
    "license": "Apache-2.0",
    "author": {
        "email": "hectorjimenez@outlook.com",
        "name": "Hector Jimenez",
        "url": "https://github.com/hectorjjb"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Themes"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/hectorjjb/vs-code-xbox-theme"
    },
    "bugs": {
        "url": "https://github.com/hectorjjb/vs-code-xbox-theme/issues",
        "email": "hectorjimenez@outlook.com"
    },
    "keywords": [
        "vscode-theme",
        "theme",
        "xbox",
        "green",
        "dark theme",
        "light theme",
        "color-theme"
    ],
    "galleryBanner": {
        "color": "#107c10",
        "theme": "dark"
    },
    "qna": "marketplace",
    "sponsor": {
        "url": "https://github.com/sponsors/hectorjjb"
    },
    "preview": false,
    "homepage": "https://github.com/hectorjjb/vs-code-xbox-theme",
    "scripts": {
        "build": "node scripts/build-themes.mjs",
        "build:icons": "node scripts/build-icon-theme.mjs",
        "screenshots": "node scripts/screenshots.mjs",
        "validate": "node scripts/validate-themes.mjs",
        "test": "npm run build && npm run validate",
        "package": "vsce package",
        "publish:vsce": "vsce publish",
        "publish:ovsx": "ovsx publish",
        "prepublishOnly": "npm run test"
    },
    "devDependencies": {
        "@vscode/vsce": "^3.2.1",
        "ovsx": "^1.0.1",
        "playwright": "^1.60.0",
        "shiki": "^1.29.2"
    },
    "contributes": {
        "themes": [
            {
                "label": "XBOX (Original 2001)",
                "uiTheme": "vs-dark",
                "path": "./themes/xbox-original.color-theme.json"
            },
            {
                "label": "XBOX ONE (2013)",
                "uiTheme": "vs-dark",
                "path": "./themes/xbox-one.color-theme.json"
            },
            {
                "label": "XBOX 360 (2005)",
                "uiTheme": "vs",
                "path": "./themes/xbox-360.color-theme.json"
            },
            {
                "label": "XBOX Series X (2020)",
                "uiTheme": "vs-dark",
                "path": "./themes/xbox-series-x.color-theme.json"
            },
            {
                "label": "XBOX High Contrast Dark",
                "uiTheme": "hc-black",
                "path": "./themes/xbox-hc-dark.color-theme.json"
            },
            {
                "label": "XBOX High Contrast Light",
                "uiTheme": "hc-light",
                "path": "./themes/xbox-hc-light.color-theme.json"
            }
        ],
        "iconThemes": [
            {
                "id": "xbox-icons",
                "label": "XBOX Icons",
                "path": "./fileicons/xbox-icon-theme.json"
            }
        ]
    }
}
