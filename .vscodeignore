# Source control
.git/**
.gitignore
.gitattributes

# GitHub
.github/**

# VS Code workspace
.vscode/**

# Repo planning / dev docs (not for the marketplace package)
docs/**
plan.md

# Sample code (only used for taking screenshots — not shipped)
samples/**

# Generated theme previews (regenerable via `npm run screenshots`) — not shipped
previews/**

# Marketplace screenshots are embedded in the README via raw.githubusercontent URLs,
# so they don't need to ship inside the .vsix. Keep only the extension icon.
images/*.png
!images/xbox-logo.png

# Source / build tooling
src/**
scripts/**
node_modules/**
package-lock.json
tsconfig*.json
.eslintrc*
.editorconfig
.prettierrc*
.cache/**

# Logs / misc
*.log
*.vsix
